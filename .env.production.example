# Base de données
DATABASE_NAME=training_camp
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-strong-password

# Application
JWT_SECRET=change-me-very-long-random-string-at-least-64-chars
NODE_ENV=production
FRONTEND_URL=https://training-camp.duckdns.org
PORT=3001

# OpenAI
OPENAI_API_KEY=sk-...

# Google Calendar OAuth
GOOGLE_CLIENT_ID=390464130557-lo00g0uhrc90jsdrt3khcjrnsvl8mgum.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=https://training-camp.duckdns.org/api/calendar/google/callback
# Clé AES-256 qui chiffre les refresh_token Google en base (64 caractères hexadécimaux).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne jamais la changer sans reconnecter les utilisateurs : les tokens chiffrés avec l'ancienne deviennent illisibles.
TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars

# DuckDNS
DUCKDNS_TOKEN=change-me
